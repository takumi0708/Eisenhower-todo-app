{
    // backendのファルダ内のtsをどんなルール、環境デコンパイルするか決める設定ファイル
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "src"
    ]
}